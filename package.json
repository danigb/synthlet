{
  "name": "synthlet-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@types/audioworklet": "^0.0.60",
    "@types/jest": "^29.5.12",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.1.5",
    "tsup": "^8.3.0",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^synthlet/dsp$": "<rootDir>/packages/synthlet/src/dsp-entry.ts",
      "^@synthlet/([^/]+)/dsp$": "<rootDir>/packages/$1/src/dsp-entry.ts",
      "^@synthlet/(.*)$": "<rootDir>/packages/$1/src/index.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "scripts": {
    "build": "turbo build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint",
    "check:rates": "node scripts/check-param-rates.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "npm run build && npm run test",
    "processors": "find ./packages -name 'processor.ts' -exec wc -m {} +",
    "bump": "changeset version && npm run publish:prepare",
    "publish:prepare": "cp README.md packages/synthlet && cp packages/synthlet/CHANGELOG.md CHANGELOG.md"
  },
  "packageManager": "npm@7.21.0"
}
