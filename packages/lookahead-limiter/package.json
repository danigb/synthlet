{
  "name": "@synthlet/lookahead-limiter",
  "version": "0.2.0",
  "description": "Audio lookahead brickwall limiter audio worklet",
  "keywords": [
    "audio-limiter",
    "brickwall",
    "compressor",
    "lookahead-limiter",
    "modular",
    "synthesis",
    "synthlet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danigb/synthlet.git",
    "directory": "packages/lookahead-limiter"
  },
  "homepage": "https://danigb.github.io/synthlet/docs/lookahead-limiter",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dsp": {
      "synthlet-source": "./src/dsp-entry.ts",
      "import": {
        "types": "./dist/dsp.d.mts",
        "default": "./dist/dsp.mjs"
      },
      "require": {
        "types": "./dist/dsp.d.ts",
        "default": "./dist/dsp.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "author": "danigb@gmail.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "scripts": {
    "worklet": "esbuild src/worklet.ts --bundle --minify | sed -e 's/^/export const PROCESSOR = \\`/' -e 's/$/\\`;/'  > src/processor.ts",
    "lib": "tsup --entry.index=src/index.ts --entry.dsp=src/dsp-entry.ts --sourcemap --dts --format esm,cjs",
    "build": "npm run worklet && npm run lib",
    "test": "jest"
  }
}
