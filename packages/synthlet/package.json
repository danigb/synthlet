{
  "name": "synthlet",
  "version": "0.13.0",
  "description": "Modular synthesis in the browser",
  "keywords": [
    "modular",
    "synthesizer",
    "webaudio",
    "control-voltage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danigb/synthlet.git",
    "directory": "packages/synthlet"
  },
  "homepage": "https://danigb.github.io/synthlet/docs/quick-start",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dsp": {
      "synthlet-source": "./src/dsp-entry.ts",
      "import": {
        "types": "./dist/dsp.d.mts",
        "default": "./dist/dsp.mjs"
      },
      "require": {
        "types": "./dist/dsp.d.ts",
        "default": "./dist/dsp.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "author": "danigb@gmail.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@synthlet/ad": "^0.2.0",
    "@synthlet/adsr": "^0.2.0",
    "@synthlet/analog-delay": "^0.1.0",
    "@synthlet/arp": "^0.2.0",
    "@synthlet/chorus": "^0.2.0",
    "@synthlet/clip-amp": "^0.2.0",
    "@synthlet/clock": "^0.2.0",
    "@synthlet/dattorro-reverb": "^0.2.0",
    "@synthlet/digital-delay": "^0.1.0",
    "@synthlet/euclid": "^0.2.0",
    "@synthlet/granite": "^0.2.0",
    "@synthlet/impulse": "^0.2.0",
    "@synthlet/karplus-strong": "^0.2.0",
    "@synthlet/level-meter": "^0.2.0",
    "@synthlet/lfo": "^0.2.0",
    "@synthlet/lookahead-limiter": "^0.2.0",
    "@synthlet/noise": "^0.2.0",
    "@synthlet/param": "^0.2.0",
    "@synthlet/polyblep-oscillator": "^0.3.0",
    "@synthlet/reverb-delay": "^0.2.0",
    "@synthlet/ring-mod": "^0.1.0",
    "@synthlet/sample-hold": "^0.1.0",
    "@synthlet/state-variable-filter": "^0.3.0",
    "@synthlet/timestretch-audio-source": "^0.1.0",
    "@synthlet/virtual-analog-filter": "^0.2.0",
    "@synthlet/wavetable-oscillator": "^0.3.0"
  },
  "scripts": {
    "build": "tsup --entry.index=src/index.ts --entry.dsp=src/dsp-entry.ts --sourcemap --dts --format esm,cjs",
    "lint": "tsc --noEmit",
    "test": "jest"
  }
}
