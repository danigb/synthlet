{
  // Tests resolve @synthlet/* to package sources, mirroring the jest
  // moduleNameMapper. Without this, TypeScript follows each package's
  // "types" field to dist/, which only exists after a build - so `npm test`
  // on a fresh clone saw `unknown` for every cross-package type.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    // `paths` replaces the base config's rather than merging with it, so the
    // `./dsp` subpaths are repeated here.
    "paths": {
      "synthlet/dsp": ["packages/synthlet/src/dsp-entry.ts"],
      "@synthlet/level-meter/dsp": ["packages/level-meter/src/dsp-entry.ts"],
      "@synthlet/lookahead-limiter/dsp": [
        "packages/lookahead-limiter/src/dsp-entry.ts"
      ],
      "@synthlet/*": ["packages/*/src/index.ts"]
    }
  }
}
