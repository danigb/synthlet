{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "postinstall": "fumadocs-mdx",
    "check:links": "node scripts/check-learn-links.mjs",
    "check:sound": "node scripts/check-learn-sound.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run deploy:build && npm run deploy:push",
    "deploy:build": "DEPLOY=true next build && npm run deploy:fix",
    "deploy:fix": "cp out/docs/quick-start.html out/docs/index.html",
    "deploy:push": "gh-pages -d out/ -t true"
  },
  "dependencies": {
    "fumadocs-core": "^13.4.10",
    "fumadocs-docgen": "^1.2.0",
    "fumadocs-mdx": "^10.0.2",
    "fumadocs-typescript": "^2.1.0",
    "fumadocs-ui": "^13.4.10",
    "lucide-react": "^0.447.0",
    "next": "^14.2.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.1.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.47",
    "shiki": "^1.16.2",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
